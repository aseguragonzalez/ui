{
  // $schema provides code completion hints to IDEs.
  "$schema": "https://github.com/IBM/audit-ci/raw/main/docs/schema.json",
  "high": true,
  // The allowlist is empty on purpose. Every entry it used to carry covered a
  // copy bundled inside npm's own dependencies, which package.json overrides
  // cannot reach; npm 11.19.1 ships fixed versions of all of them, so the
  // entries stopped matching anything. Prefer moving the dependency over
  // re-adding an entry here.
  "allowlist": [],
}
